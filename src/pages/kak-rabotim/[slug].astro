---
import '@/styles/inner/index.css';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import StepMedia from '@/components/blocks/steps/StepMedia.astro';
import CtaPanel from '@/components/blocks/CtaPanel.astro';
import { stepsPhotoCredits } from '@/data/photo-credits';

export async function getStaticPaths() {
  const steps = (await getCollection('kak-rabotim')).sort((a, b) => a.data.order - b.data.order);
  return steps.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: steps[i - 1], next: steps[i + 1], total: steps.length },
  }));
}

interface Props {
  entry: CollectionEntry<'kak-rabotim'>;
  prev: CollectionEntry<'kak-rabotim'> | undefined;
  next: CollectionEntry<'kak-rabotim'> | undefined;
  total: number;
}
const { entry, prev, next, total } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const pad = (n: number) => String(n).padStart(2, '0');

// First step links back to the overview; the last one continues to the 3D process (as in the original).
const back = prev
  ? { href: `/kak-rabotim/${prev.id}/`, small: 'Предишна стъпка', label: prev.data.title }
  : { href: '/kak-rabotim/', small: 'Всички стъпки', label: 'Как работим?' };
const forward = next
  ? { href: `/kak-rabotim/${next.id}/`, small: 'Следваща стъпка', label: next.data.title }
  : { href: '/proces/', small: 'Целият процес', label: 'Процесът в 3D' };
const quotePhoto = data.quote.photo;
---

<BaseLayout title={data.seo.title} description={data.seo.description} credits={stepsPhotoCredits}>
  <PageHero
    eyebrow={`Стъпка ${pad(data.order)} от ${pad(total)}`}
    title={data.title}
    long={data.heroLong}
    crumbs={[{ label: 'Как работим?', href: '/kak-rabotim/' }, { label: data.title }]}
    mediaClass={data.media.type === 'photo' ? undefined : 'str-glava__kadar--gr'}
  >
    {data.lead}
    <StepMedia slot="media" media={data.media} sizes="(max-width: 1300px) 92vw, 1240px" hero />
  </PageHero>

  <section class="sek">
    <div class="obv">
      <div class="tekst-kol">
        <div class="tekst-kol__lyavo">
          <span class="st-golyama__n">{pad(data.order)}</span>
          <p class="izrechenie izrechenie--s u-mt-14">{data.statement}</p>
        </div>
        <div class="proza proza--podzaglavia">
          <p>{data.summary}</p>
          <Content />
        </div>
      </div>
    </div>
  </section>

  <section class="sek u-pt-0">
    <div class="obv">
      <div class:list={['tsitat-blok', { 'tsitat-blok--sam': !quotePhoto }]}>
        <figure class="tsitat vlez">
          <span class="otziv__k">
            <svg viewBox="0 0 44 36" aria-hidden="true">
              <path
                fill="currentColor"
                d="M0 36V22.3C0 9.6 6 2.2 17.4 0l2.2 4.5C13.3 6.4 10.2 10.2 9.9 16h8.6v20Zm24.6 0V22.3C24.6 9.6 30.6 2.2 42 0l2 4.5c-6.3 1.9-9.4 5.7-9.7 11.5h8.6v20Z"
              ></path>
            </svg>
          </span>
          <blockquote>{data.quote.text}</blockquote>
          <figcaption>{data.quote.caption}</figcaption>
        </figure>
        {
          quotePhoto && (
            <div class="tsitat-blok__kadar otkrii">
              <Image
                src={quotePhoto.image}
                alt={quotePhoto.alt}
                widths={[640, 1200]}
                sizes="(max-width: 980px) 92vw, 600px"
                loading="lazy"
                decoding="async"
              />
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="sek sek--malko u-pt-0">
    <div class="obv">
      <nav class="st-nav" aria-label="Другите стъпки">
        <a class="st-nav__a" href={back.href}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg
          >
          <span><small>{back.small}</small><b>{back.label}</b></span>
        </a>
        <a class="st-nav__a st-nav__a--d" href={forward.href}>
          <span><small>{forward.small}</small><b>{forward.label}</b></span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
          >
        </a>
      </nav>
    </div>
  </section>

  <CtaPanel />
</BaseLayout>
