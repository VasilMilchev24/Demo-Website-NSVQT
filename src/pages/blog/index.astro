---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
// Page styles after the layout's global styles (the original's cascade order).
import '@/styles/inner/index.css';
import PageHero from '@/components/blocks/PageHero.astro';
import BlogCards from '@/components/blocks/BlogCards.astro';
import CtaPanel from '@/components/blocks/CtaPanel.astro';
import Icon from '@/components/ui/Icon.astro';
import { formatDate, isoDate } from '@/lib/format';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [featured] = posts;
const lead = 'Съвети за ремонта на жилище, фасада и покрив във Варна и региона: преди, по време и след ремонта.';
---

{/* FIX T-11: the original used the site-wide default description here; now the page's own lead. */}
<BaseLayout title="Блог" description={lead}>
  <PageHero eyebrow="Последно от блога" title="Блог" crumbs={[{ label: 'Блог' }]} buttons={false}>
    {lead}
  </PageHero>

  <section class="sek u-pt-0">
    <div class="obv">
      {
        featured && (
          <a class="statiya-gl vlez" href={`/blog/${featured.id}/`}>
            <div class="statiya-gl__kadar">
              <Image
                src={featured.data.image}
                alt=""
                widths={[640, 1024]}
                sizes="(max-width: 980px) 92vw, 680px"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="statiya-gl__t">
              <div class="statiya-k__meta">
                <span class="chip">{featured.data.category}</span>
                <time datetime={isoDate(featured.data.date)}>{formatDate(featured.data.date)}</time>
              </div>
              <h2 class="h-3">{featured.data.title}</h2>
              <p>{featured.data.excerpt ?? featured.data.seo.description}</p>
              <span class="vrazka">
                Прочетете <Icon name="arrow" />
              </span>
            </div>
          </a>
        )
      }
      <BlogCards skip={1} limit={posts.length} class="u-mt-40" />
    </div>
  </section>

  <CtaPanel />
</BaseLayout>
