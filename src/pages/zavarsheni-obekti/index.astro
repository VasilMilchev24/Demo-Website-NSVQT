---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
// Page styles after the layout's global styles (the original's cascade order).
import '@/styles/inner/index.css';
import PageHero from '@/components/blocks/PageHero.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import CtaPanel from '@/components/blocks/CtaPanel.astro';
import Icon from '@/components/ui/Icon.astro';

const projects = (await getCollection('obekti')).sort((a, b) => a.data.order - b.data.order);
/** The cover first, then the first two other photos (the original's order on this page). */
const listPhotos = (p: (typeof projects)[number]) => {
  const { photos, cover } = p.data;
  return [photos[cover], ...photos.filter((_, i) => i !== cover).slice(0, 2)].filter((x) => x !== undefined);
};
---

<BaseLayout title="Завършени обекти" description="Вижте наши завършени обекти във Варна">
  <PageHero eyebrow="Варна и региона" title="Завършени обекти" crumbs={[{ label: 'Завършени обекти' }]} buttons={false}>
    Нашите завършени проекти: домове, преобразени с наша помощ във Варна и региона.
    <div slot="after-lead" class="btn-red u-mt-26">
      <a class="btn btn--linia" href="/galeriya/">Галерия <Icon name="arrow" /></a>
    </div>
  </PageHero>

  <section class="sek u-pt-0">
    <div class="obv">
      <div class="obekti-golemi">
        {
          projects.map((p) => (
            <a class="ob-golyam vlez" href={`/zavarsheni-obekti/${p.id}/`}>
              <div class="ob-golyam__snimki">
                {listPhotos(p).map((photo, k) => (
                  <span class={`ob-golyam__k ob-golyam__k--${k}`}>
                    <Image
                      src={photo}
                      alt={k === 0 ? p.data.title : ''}
                      widths={[640, 1080]}
                      sizes={k === 0 ? '(max-width: 980px) 92vw, 560px' : '260px'}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                ))}
              </div>
              <div class="ob-golyam__t">
                <span class="chip">
                  <Icon name="pin" size={14}>
                    <circle cx="12" cy="10" r="2.4" />
                  </Icon>{' '}
                  {p.data.location}
                </span>
                <span class="chip">{p.data.homeType}</span>
                <span class="chip">{p.data.photos.length} снимки</span>
                <h2 class="h-3">{p.data.title}</h2>
                <p class="vodach">{p.data.lead}</p>
                <p>{p.data.intro}</p>
                <span class="vrazka">
                  Прочети още <Icon name="arrow" />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Testimonials />
  <CtaPanel />
</BaseLayout>
