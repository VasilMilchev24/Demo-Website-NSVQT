---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate, isoDate } from '@/lib/format';

/** Latest blog articles as cards. `exclude` hides the current article; `limit` caps the count. */
interface Props {
  limit?: number;
  exclude?: string;
}
const { limit = 3, exclude } = Astro.props;
const posts = (await getCollection('blog'))
  .filter((p) => p.id !== exclude)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, limit);
---

<div class="blog-red">
  {
    posts.map((p, i) => (
      <a class="statiya-k vlez" data-zabava={i} href={`/blog/${p.id}/`}>
        <div class="statiya-k__kadar">
          <Image
            src={p.data.image}
            alt=""
            widths={[640, 1024]}
            sizes="(max-width: 980px) 92vw, 400px"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="statiya-k__meta">
          <span class="chip">{p.data.category}</span>
          <time datetime={isoDate(p.data.date)}>{formatDate(p.data.date)}</time>
        </div>
        <h3>{p.data.title}</h3>
      </a>
    ))
  }
</div>
