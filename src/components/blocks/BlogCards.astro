---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate, isoDate } from '@/lib/format';

/**
 * Blog articles (newest first) as cards. `exclude` hides the current article; `skip` drops the first N
 * (the featured article on /blog/); `limit` caps the count.
 */
interface Props {
  limit?: number;
  skip?: number;
  exclude?: string;
  class?: string;
}
const { limit = 3, skip = 0, exclude, class: extra } = Astro.props;
const posts = (await getCollection('blog'))
  .filter((p) => p.id !== exclude)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(skip, skip + limit);
---

<div class:list={['blog-red', extra]}>
  {
    posts.map((p, i) => (
      <a class="statiya-k vlez" data-zabava={i % 3} href={`/blog/${p.id}/`}>
        <div class="statiya-k__kadar">
          <Image
            src={p.data.image}
            alt=""
            widths={[640, 1024]}
            sizes="(max-width: 980px) 92vw, 400px"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="statiya-k__meta">
          <span class="chip">{p.data.category}</span>
          <time datetime={isoDate(p.data.date)}>{formatDate(p.data.date)}</time>
        </div>
        <h3>{p.data.title}</h3>
      </a>
    ))
  }
</div>
