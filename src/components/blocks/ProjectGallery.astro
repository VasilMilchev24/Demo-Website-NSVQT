---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

/**
 * Photo grid with lightbox (`[data-galeriya]`, handled by scripts/core/gallery.ts). Each link points at
 * the 1080px photo the lightbox opens. `filterable` adds `data-obekt` for the /galeriya/ filter buttons.
 */
interface Props {
  projects: CollectionEntry<'obekti'>[];
  filterable?: boolean;
}
const { projects, filterable = false } = Astro.props;

const items = await Promise.all(
  projects.flatMap((p) =>
    p.data.photos.map(async (photo, n) => ({
      project: p.id,
      photo,
      // FIX T-08: unique alt per photo (the original /galeriya/ repeated the project title 21 times).
      alt: `${p.data.title}, снимка ${n + 1}`,
      full: (await getImage({ src: photo, width: Math.min(1080, photo.width), format: 'webp' })).src,
    })),
  ),
);
---

<div class="galeriya" data-galeriya>
  {
    items.map((item, i) => (
      <a href={item.full} data-uvel={i} data-obekt={filterable ? item.project : undefined}>
        <Image
          src={item.photo}
          alt={item.alt}
          widths={[640, 1080].filter((w) => w <= item.photo.width)}
          sizes="(max-width: 700px) 92vw, 400px"
          loading="lazy"
          decoding="async"
        />
      </a>
    ))
  }
</div>
