---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { testimonials } from '@/data/testimonials';
---

<section class="sek sek--tamno">
  <div class="obv">
    <SectionHeader eyebrow="Какво казват клиентите" title="Отзиви" />
    <div class="otzivi">
      {
        testimonials.map((t, i) => (
          <figure class="otziv vlez" data-zabava={i}>
            <span class="otziv__k">
              <svg viewBox="0 0 44 36" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M0 36V22.3C0 9.6 6 2.2 17.4 0l2.2 4.5C13.3 6.4 10.2 10.2 9.9 16h8.6v20Zm24.6 0V22.3C24.6 9.6 30.6 2.2 42 0l2 4.5c-6.3 1.9-9.4 5.7-9.7 11.5h8.6v20Z"
                />
              </svg>
            </span>
            <blockquote>{t.quote}</blockquote>
            <figcaption>{t.author}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
