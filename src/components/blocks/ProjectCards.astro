---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';

/** Completed-project cards (photo + hover photo, location chip). `exclude` hides the current project. */
interface Props {
  exclude?: string;
}
const { exclude } = Astro.props;
const projects = (await getCollection('obekti'))
  .filter((p) => p.id !== exclude)
  .sort((a, b) => a.data.order - b.data.order);
---

<div class="obekti">
  {
    projects.map((p, i) => {
      const main = p.data.photos[p.data.cover];
      const hover = p.data.photos[p.data.coverHover];
      return (
        <a class="obekt vlez" data-zabava={i} href={`/zavarsheni-obekti/${p.id}/`}>
          <div class="obekt__kadar">
            <span class="obekt__znak">
              <Icon name="pin" size={14}>
                <circle cx="12" cy="10" r="2.4" />
              </Icon>{' '}
              {p.data.location}
            </span>
            {main && (
              <Image
                src={main}
                alt={p.data.title}
                widths={[640, 1080]}
                sizes="(max-width: 980px) 92vw, 400px"
                loading="lazy"
                decoding="async"
              />
            )}
            {hover && <Image src={hover} alt="" widths={[640]} sizes="400px" loading="lazy" decoding="async" />}
          </div>
          <h3>{p.data.title}</h3>
          <p>{p.data.lead}</p>
        </a>
      );
    })
  }
</div>
