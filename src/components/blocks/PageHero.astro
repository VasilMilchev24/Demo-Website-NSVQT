---
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';

/**
 * Inner-page hero (`.str-glava`): breadcrumbs, eyebrow, H1, lead (default slot) and the two contact
 * buttons. An optional wide image goes in the "media" slot (rendered in `.str-glava__kadar`).
 */
interface Props {
  eyebrow: string;
  title: string;
  crumbs: { label: string; href?: string }[];
  /** Show "Безплатен оглед" + phone buttons under the lead (default true). */
  buttons?: boolean;
  /** Wide H1 style (`.dalgo`). */
  long?: boolean;
  /** Extra classes for the media frame. */
  mediaClass?: string | undefined;
}
const { eyebrow, title, crumbs, buttons = true, long = false, mediaClass } = Astro.props;
---

<section class="str-glava">
  <div class="obv">
    <Breadcrumbs items={crumbs} />
    <div class="str-glava__red">
      <div>
        <span class="etiket vlez">{eyebrow}</span>
        <h1 class:list={['redove', { dalgo: long }, 'u-mt-22']}><span class="red"><span>{title}</span></span></h1>
      </div>
      <div class="vlez" data-zabava="1">
        <p class="vodach"><slot /></p>
        {
          buttons && (
            <div class="btn-red u-mt-26">
              <Button href="/kontakti/#forma">Безплатен оглед</Button>
              <Button href={site.phone.href} variant="linia">
                {' '}
                {site.phone.display}
              </Button>
            </div>
          )
        }
        <slot name="after-lead" />
      </div>
    </div>
    {
      Astro.slots.has('media') && (
        <div class:list={['str-glava__kadar', 'otkrii', mediaClass]}>
          <slot name="media" />
        </div>
      )
    }
  </div>
</section>
