---
import SectionHeader from '@/components/ui/SectionHeader.astro';

/**
 * "Защо Ремонт Студио" tiles. As in the original, the icons follow a fixed order by position
 * (team, offer, contract, shield, sparkle, house) regardless of the tile text.
 */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string | undefined;
  dark: boolean;
  items: { title: string; text: string }[];
  flush: boolean;
}
const { eyebrow, title, lead, dark, items, flush } = Astro.props;
---

<section class:list={['sek', { 'sek--tamno': dark, 'u-pt-0': flush }]}>
  <div class="obv">
    <SectionHeader eyebrow={eyebrow} title={title} lead={lead} />
    <div class="zashto" data-n={items.length}>
      {
        items.map((t, i) => (
          <div class="zashto__t vlez" data-zabava={i % 3}>
            <span class="ik">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {i === 0 && (
                  <>
                    <circle cx="9" cy="8.5" r="3" />
                    <path d="M3.5 19c.6-3 2.8-4.5 5.5-4.5s4.9 1.5 5.5 4.5" />
                    <circle cx="17" cy="9.5" r="2.3" />
                    <path d="M15.8 14.6c2.3.1 4 1.3 4.6 4" />
                  </>
                )}
                {i === 1 && (
                  <>
                    <path d="M7 3.5h7l4 4V19a1.5 1.5 0 0 1-1.5 1.5h-9.5A1.5 1.5 0 0 1 5.5 19V5A1.5 1.5 0 0 1 7 3.5Z" />
                    <path d="M13.5 3.5V8h4.5M8.5 12h7M8.5 15.5h7M8.5 8.5h2.5" />
                  </>
                )}
                {i === 2 && (
                  <>
                    <path d="M6 3.5h12a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1Z" />
                    <path d="M8.5 8h7M8.5 11h5M8 17c1.2-1.6 2-1.6 2.6 0 .5 1.2 1.2 1.2 2-.2.6-1 1.3-.9 2 .2.4.6 1 .6 1.4 0" />
                  </>
                )}
                {i === 3 && (
                  <>
                    <path d="M12 3.5 19 6v5.6c0 4.4-3 7.6-7 8.9-4-1.3-7-4.5-7-8.9V6Z" />
                    <path d="m9 12 2.2 2.2L15.5 10" />
                  </>
                )}
                {i === 4 && (
                  <>
                    <path d="M12 3.5 13.6 9l5.4 1.6-5.4 1.6L12 17.6l-1.6-5.4L5 10.6 10.4 9Z" />
                    <path d="M18.5 15.5l.6 2 2 .6-2 .6-.6 2-.6-2-2-.6 2-.6Z" />
                  </>
                )}
                {i === 5 && (
                  <>
                    <path d="M4 10.5 12 4l8 6.5V19a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19Z" />
                    <rect x="9.5" y="12" width="5" height="5" rx=".8" />
                    <path d="M12 12v5M9.5 14.5h5" />
                  </>
                )}
              </svg>
            </span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
