---
/**
 * The four "numbers" cards (Процесът / Огледът / Екипът / Гаранцията), used on the home page and /za-nas/.
 * Counters animate from `data-ot` to `data-broi`; the HTML holds the final value (no-JS safe).
 * Graphics are the original inline SVGs; CSS animates them through --i / --x / --y.
 */
const stepNodes = [
  [10, 96],
  [70, 52],
  [130, 44],
  [195, 74],
  [250, 24],
] as const;
const crew = [
  { x: '100px', y: '40px', cx: 30, cy: 26 },
  { x: '-98px', y: '44px', cx: 228, cy: 22 },
  { x: '110px', y: '-38px', cx: 20, cy: 104 },
  { x: '-106px', y: '-44px', cx: 236, cy: 110 },
  { x: '0px', y: '54px', cx: 130, cy: 12 },
  { x: '4px', y: '-54px', cx: 126, cy: 120 },
] as const;
const years = [
  { x: 8, y: 83, h: 17 },
  { x: 58, y: 66, h: 34 },
  { x: 108, y: 49, h: 51 },
  { x: 158, y: 32, h: 68 },
  { x: 208, y: 15, h: 85 },
] as const;
---

<div class="chisla" data-chisla>
  <article class="chislo chislo--navy vlez">
    <div class="chislo__gore"><span>Процесът</span><span>01</span></div>
    <div class="chislo__n"><span data-broi="5">5</span><small>стъпки</small></div>
    <div class="chislo__gr gr gr--stapki">
      <svg viewBox="0 0 260 120" aria-hidden="true">
        <path
          class="gr-pat"
          d="M10 96 C 60 96, 60 30, 110 30 S 160 96, 205 70 S 240 24, 250 24"
          fill="none"
          stroke="currentColor"
          stroke-opacity=".3"
          stroke-width="2"
          stroke-dasharray="4 6"></path>
        {
          stepNodes.map(([cx, cy], i) => (
            <g class="gr-vazel" style={`--i:${i}`}>
              <circle cx={cx} cy={cy} r="11" fill="#4CACD8" />
              <text
                x={cx}
                y={cy + 4}
                text-anchor="middle"
                font-size="11"
                font-weight="700"
                fill="#24345C"
                font-family="Manrope"
              >
                {i + 1}
              </text>
            </g>
          ))
        }
        <circle class="gr-tochka" r="5" fill="#fff"></circle>
      </svg>
    </div>
    <h3 class="chislo__ime">От огледа до почистването</h3>
    <p>Оглед, оферта, договор, изпълнение, финално почистване.</p>
  </article>

  <article class="chislo chislo--nebe vlez" data-zabava="1">
    <div class="chislo__gore"><span>Огледът</span><span>02</span></div>
    <div class="chislo__n"><span data-broi="0" data-ot="90">0</span><small>€</small></div>
    <div class="chislo__gr gr gr--ogled">
      <svg viewBox="0 0 260 130" aria-hidden="true">
        <g class="gr-etiket">
          <path
            d="M40 20h150l40 45-40 45H40a14 14 0 0 1-14-14V34a14 14 0 0 1 14-14Z"
            fill="#fff"
            fill-opacity=".9"></path>
          <circle cx="196" cy="65" r="7" fill="#4CACD8"></circle>
          <text x="50" y="58" font-family="Unbounded" font-weight="600" font-size="15" fill="#24345C">Оглед</text>
          <text x="50" y="84" font-family="Manrope" font-weight="700" font-size="13" fill="#24345C" fill-opacity=".6"
            >и консултация</text
          >
        </g>
        <path class="gr-cherta" d="M44 98 L178 98" stroke="#24345C" stroke-width="3" stroke-linecap="round"></path>
      </svg>
    </div>
    <h3 class="chislo__ime">Безплатен оглед</h3>
    <p>И професионална консултация на територията на Варна и региона.</p>
  </article>

  <article class="chislo vlez" data-zabava="2">
    <div class="chislo__gore"><span>Екипът</span><span>03</span></div>
    <div class="chislo__n"><span data-broi="1" data-ot="6">1</span><small>партньор</small></div>
    <div class="chislo__gr gr gr--ekip">
      <svg viewBox="0 0 260 130" aria-hidden="true">
        {
          crew.map((m, i) => (
            <g class="gr-maistor" style={`--x:${m.x};--y:${m.y};--i:${i}`}>
              <circle cx={m.cx} cy={m.cy} r="12" fill="none" stroke="#24345C" stroke-width="2" />
              <circle cx={m.cx} cy={m.cy - 3} r="3.5" fill="#24345C" />
              <path d={`M${m.cx - 6} ${m.cy + 7}a6 6 0 0 1 12 0`} fill="#24345C" />
            </g>
          ))
        }
        <circle class="gr-edin" cx="130" cy="66" r="30" fill="#24345C"></circle>
        <path
          class="gr-edin"
          d="m118 66 8 8 16-16"
          fill="none"
          stroke="#4CACD8"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>
    <h3 class="chislo__ime">За целия процес</h3>
    <p>Координираме основните ремонтни и довършителни дейности.</p>
  </article>

  <article class="chislo chislo--blido vlez" data-zabava="3">
    <div class="chislo__gore"><span>Гаранцията</span><span>04</span></div>
    <div class="chislo__n"><span data-broi="5">5</span><small>години</small></div>
    <div class="chislo__gr gr gr--garantsiya">
      <svg viewBox="0 0 260 130" aria-hidden="true">
        {
          years.map((y, i) => (
            <g class="gr-godina" style={`--i:${i}`}>
              <rect x={y.x} y={y.y} width="40" height={y.h} rx="8" fill="#24345C" />
              <text
                x={y.x + 20}
                y="122"
                text-anchor="middle"
                font-family="Manrope"
                font-weight="700"
                font-size="12"
                fill="#24345C"
                fill-opacity=".55"
              >
                {i + 1} г.
              </text>
            </g>
          ))
        }
      </svg>
    </div>
    <h3 class="chislo__ime">Гаранция</h3>
    <p>За извършените от нас ремонтни дейности, в договор.</p>
  </article>
</div>
