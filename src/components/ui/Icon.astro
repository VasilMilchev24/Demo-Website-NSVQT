---
/**
 * Stroke icon (24×24, currentColor). Decorative by default (aria-hidden); pass `label` for an accessible name.
 * Extra shapes (rect/circle) for the few icons that need them come through the default slot.
 */
import { ICON_PATHS, type IconName } from './icons';

interface Props {
  name: IconName;
  label?: string;
  class?: string;
  size?: number;
}

const { name, label, class: className, size } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  width={size}
  height={size}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  <slot />
  {ICON_PATHS[name].map((d) => <path d={d} />)}
</svg>
