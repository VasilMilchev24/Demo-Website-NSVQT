---
/**
 * Stroke icons used across the site (24×24, currentColor). Paths are copied from the original markup.
 * Decorative by default (aria-hidden); pass `label` to expose an accessible name.
 */
const PATHS = {
  arrow: ['M5 12h14M13 6l6 6-6 6'],
  phone: [
    'M5 4h3.2l1.6 4-2 1.3a10.5 10.5 0 0 0 6.9 6.9l1.3-2 4 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z',
  ],
  'chevron-down': ['m6 9 6 6 6-6'],
  'chevron-right': ['m9 6 6 6-6 6'],
  viber: [
    'M12 3c5 0 8 2.6 8 7.7 0 5.2-3.2 7.4-8 7.4-.8 0-1.6-.1-2.4-.2L6 20.5v-3.5C4.6 15.7 4 13.6 4 10.7 4 5.6 7 3 12 3Z',
    'M9.3 8.2c.4-.5 1-.4 1.3.1l.6 1c.2.4.1.9-.3 1.2l-.3.2c.4 1 1.2 1.8 2.2 2.2l.2-.3c.3-.4.8-.5 1.2-.3l1 .6c.5.3.6.9.1 1.3-.7.7-1.7.9-2.6.5a7.6 7.6 0 0 1-3.9-3.9c-.4-.9-.2-1.9.5-2.6Z',
  ],
} as const;

export type IconName = keyof typeof PATHS;

interface Props {
  name: IconName;
  label?: string;
  class?: string;
  size?: number;
}

const { name, label, class: className, size } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  width={size}
  height={size}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
